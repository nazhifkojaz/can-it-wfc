# ==========================================
# LOCAL DEVELOPMENT Environment Variables
# ==========================================
# Copy this to .env and fill in with your NEW credentials

# Django Core
DEBUG=True
SECRET_KEY=YOUR_SECRET_KEY_HERE
ALLOWED_HOSTS=localhost,127.0.0.1

# Database - You need to set this with NEW Supabase credentials
# Get from: https://supabase.com/dashboard → Settings → Database
DATABASE_URL=postgresql://postgres.NEW_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# CORS - Local frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Places API - You need NEW key
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=YOUR_NEW_GOOGLE_PLACES_API_KEY

# Google Places Config (optional)
GOOGLE_PLACES_MAX_RESULTS=20
GOOGLE_PLACES_TIMEOUT=10

# Google OAuth - You need NEW credentials
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=YOUR_NEW_CLIENT_ID.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_NEW_CLIENT_SECRET

# Supabase - You need NEW credentials
# Get from: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://YOUR_NEW_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_NEW_ANON_KEY
SUPABASE_SERVICE_KEY=YOUR_NEW_SERVICE_KEY

# Anti-Spam (optional)
MIN_ACCOUNT_AGE_HOURS=0
MAX_REVIEWS_PER_DAY=10
