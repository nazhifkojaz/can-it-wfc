# ==========================================
# Can-It-WFC Frontend Environment Variables
# ==========================================
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to git (it's in .gitignore)

# ==========================================
# API Configuration
# ==========================================

# Backend API URL
# Development (local backend):
VITE_API_URL=http://localhost:8000/api

# Production examples:
# With Fly.io backend:
# VITE_API_URL=https://your-app-name.fly.dev/api

# With custom domain:
# VITE_API_URL=https://api.yourdomain.com/api

# ==========================================
# OAuth Configuration
# ==========================================

# Google OAuth Client ID
# Get from: https://console.cloud.google.com/apis/credentials
# Required for Google Sign-In
VITE_GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ==========================================
# Error Monitoring (optional but recommended)
# ==========================================

# Sentry DSN for frontend error tracking
# Get from: https://sentry.io (create separate project for frontend)
# VITE_SENTRY_DSN=https://your-frontend-sentry-dsn@sentry.io/project-id

# ==========================================
# Product Analytics (PostHog)
# ==========================================

# PostHog Project API Key
# Get from: https://app.posthog.com/project/<your-project>/settings/project
# Required for analytics event tracking
VITE_POSTHOG_KEY=phc_your_project_key_here

# PostHog API Host (optional, defaults to US region)
# US region: https://us.i.posthog.com
# EU region: https://eu.i.posthog.com
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# ==========================================
# PostHog Dashboard Setup Script
# ==========================================
# Only needed for `npm run setup:dashboards` (NOT used by the app)

# PostHog Personal API Key (NOT the project API key above)
# Create at: https://us.posthog.com/settings/user-api-keys
# Required scopes: dashboard (read+write), insight (read+write)
# POSTHOG_PERSONAL_API_KEY=phx_your_personal_api_key_here

# PostHog Project ID (numeric)
# Find at: PostHog > Project Settings > Project ID
# POSTHOG_PROJECT_ID=12345

# PostHog API Host (optional, defaults to US region)
# POSTHOG_HOST=https://us.i.posthog.com

# ==========================================
# Build Configuration (optional)
# ==========================================

# Base URL for GitHub Pages (if deploying to GitHub Pages)
# Leave empty for root domain, or set to repo name for project pages
# Example: If your GitHub Pages URL is https://username.github.io/can-it-wfc/
# VITE_BASE_URL=/can-it-wfc/

# For root domain (https://username.github.io/), use:
# VITE_BASE_URL=/
